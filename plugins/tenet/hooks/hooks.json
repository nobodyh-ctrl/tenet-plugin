{
  "description": "tenet guard: denies clearly destructive actions, asks on risky ones, protects secret files and keeps reviewer agents read-only.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|Read|Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/run-guard.sh\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
